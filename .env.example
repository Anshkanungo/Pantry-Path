# Kroger Products and Locations API (https://developer.kroger.com/)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Self-hosted language model: Ollama locally (default port 11434), or a vLLM server on a GPU machine
MODEL_SERVER_URL=http://localhost:11434
MODEL_NAME=qwen2.5:7b-instruct

# Open Food Facts and Nominatim ask clients to identify themselves with an app name and contact
APP_USER_AGENT=PantryPath/0.1 (contact: your-team-email@example.com)

# LLM used by the data pipeline. Any provider's key works: Gemini, Anthropic (Claude) or OpenAI.
# The provider is guessed from the key's format; set LLM_PROVIDER (gemini | anthropic | openai) to be explicit.
# LLM_MODEL is optional (each provider has a default in data-pipeline/config/pipeline.yaml).
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# Store APIs used by the request flow (Target via RedCircle is the fallback)
REDCIRCLE_API_KEY=

# Pipeline alert emails via Gmail SMTP (optional: without them, alerts are only logged).
# ALERT_SMTP_USER = the Gmail account that sends, ALERT_SMTP_PASSWORD = its app password
# (myaccount.google.com/apppasswords; needs 2-Step Verification), ALERT_EMAIL_TO = where
# alerts go. Set all three to use your own Gmail; empty = the project addresses in
# data-pipeline/config/pipeline.yaml.
ALERT_EMAIL_TO=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
