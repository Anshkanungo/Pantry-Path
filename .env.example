# Kroger Products and Locations API (https://developer.kroger.com/)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Self-hosted language model: Ollama locally (default port 11434), or a vLLM server on a GPU machine
MODEL_SERVER_URL=http://localhost:11434
MODEL_NAME=qwen2.5:7b-instruct

# Open Food Facts and Nominatim ask clients to identify themselves with an app name and contact
APP_USER_AGENT=PantryPath/0.1 (contact: your-team-email@example.com)
